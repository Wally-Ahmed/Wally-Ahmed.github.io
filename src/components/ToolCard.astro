---
interface Props {
  title: string;
  blurb: string;
  stack: string[];
  language: string;
  stars: number;
  installCmd: string;
  sourceUrl: string;
  delay: number;
}

const { title, blurb, stack, language, stars, installCmd, sourceUrl, delay } = Astro.props;
---

{/* These are servers and CLIs with no interface to photograph, so the card
    shows the thing you would actually type instead of a fake screenshot. */}
<a
  href={sourceUrl}
  target="_blank"
  rel="noopener noreferrer"
  data-delay={delay}
  class="reveal group flex min-w-0 flex-col rounded-xl border border-line bg-ink-2 p-6 transition-all duration-500 ease-[var(--ease-out-expo)] hover:-translate-y-1 hover:border-cyan/50"
>
  <div class="flex min-w-0 items-start justify-between gap-4">
    <h3
      class="min-w-0 break-words font-mono text-base font-medium text-paper transition-colors group-hover:text-cyan"
    >
      {title}
    </h3>
    <span class="chip shrink-0">
      {stars > 0 ? `★ ${stars}` : language}
    </span>
  </div>

  <p class="mt-4 flex-1 text-[0.95rem] leading-relaxed text-muted">{blurb}</p>

  <div class="mt-5 min-w-0 overflow-hidden rounded-lg border border-line bg-ink">
    <div class="flex items-center gap-1.5 border-b border-line px-3 py-1.5">
      <span class="h-2 w-2 rounded-full bg-line"></span>
      <span class="h-2 w-2 rounded-full bg-line"></span>
      <span class="ml-1 font-mono text-[0.7rem] uppercase tracking-widest text-muted"> MIT </span>
    </div>
    <pre class="overflow-x-auto px-3 py-2.5"><code
        class="font-mono text-[0.7rem] leading-relaxed text-cyan"
      ><span class="text-muted">$ </span>{installCmd}</code></pre>
  </div>

  <ul class="mt-4 flex flex-wrap gap-1.5">
    {stack.map((tech) => <li class="chip">{tech}</li>)}
  </ul>
</a>
